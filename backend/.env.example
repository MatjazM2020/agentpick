# AgentPick Backend - Environment Configuration
# Copy this to .env and adjust values as needed

# Backend Server
PORT=5000
HOST=0.0.0.0
ENV=production
LOG_LEVEL=INFO

# Azure Services (if using Azure backend)
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# Qdrant Vector Database
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333
# QDRANT_COLLECTION=models

# Agent Configuration
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-4o
# API_KEY=your-api-key
